# ---- チェーン / コントラクト ----
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_FUSE_ADDRESS=0x
NEXT_PUBLIC_FUSE_NFT_ADDRESS=0x

# ---- サーバー専用（ブラウザには渡らない） ----
# tokenURI確定用。mint/burn/出金はできない鍵。Fuseコントラクトの metadataSigner に設定する
METADATA_SIGNER_PRIVATE_KEY=0x
OPENAI_API_KEY=sk-
# 既定は gpt-image-1。gpt-image-1.5 / gpt-image-2 などに差し替え可
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuse
# バケットの公開URL（r2.dev の開発URL か独自ドメイン）。末尾スラッシュ無し
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---- scripts/ 用（初期素材のmint。Vercelには設定不要） ----
DEPLOYER_PRIVATE_KEY=0x
