# デプロイ用。web/.env.local とは別物
DEPLOYER_PRIVATE_KEY=0x
# tokenURI を確定させるバックエンドのアドレス（web の METADATA_SIGNER_PRIVATE_KEY に対応する公開アドレス）
METADATA_SIGNER_ADDRESS=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScanでソース検証する場合のみ。etherscan.io の API Dashboard で発行する
# （Etherscan V2 はキー1つで Base Sepolia を含む全チェーンをカバーする）
# foundry.toml の [etherscan] がこの変数を読むので、source して --verify を付けるだけでよい
# 例: BASESCAN_API_KEY=ABCD1234EFGH5678IJKL9012MNOP3456QR
BASESCAN_API_KEY=
